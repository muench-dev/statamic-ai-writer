{
  "name": "statamic-ai-writer",
  "version": "2.1.0",
  "private": true,
  "description": "Statamic AI Writer asset bundle",
  "scripts": {
    "test": "node --test tests/js/*.test.cjs",
    "verify": "composer validate --strict && composer test && npm test",
    "release": "release-it --no-increment",
    "release:next": "release-it",
    "build": "cp resources/js/ai-writer.js dist/js/ai-writer.js && cp resources/css/ai-writer.css dist/css/ai-writer.css"
  },
  "keywords": [
    "statamic",
    "ai-writer",
    "bard"
  ],
  "author": "Christian Münch <christian@muench.dev>",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "release-it": "^21.1.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "undici": "^7.29.1"
  }
}
